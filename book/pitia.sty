% ---------------------------------------------------------------------------
% Palette
%   Boxes:    amber  = a story (who, when, what forced it)
%             blue   = a key concept (what it is, what it costs)
%             teal   = a dumb question, and its answer
%             purple = a reflection on something that should bother you
%             gray   = where the words come from
%   Diagrams: each color is a role, the same in every figure.
% ---------------------------------------------------------------------------
\definecolor{hfHistory}{HTML}{B4580A}
\definecolor{hfHistoryBg}{HTML}{FDF4E7}
\definecolor{hfConcept}{HTML}{1F5FA8}
\definecolor{hfConceptBg}{HTML}{EAF2FB}
\definecolor{hfQuestion}{HTML}{0F766E}
\definecolor{hfQuestionBg}{HTML}{E6F4F1}
\definecolor{hfReflect}{HTML}{7B3FA0}
\definecolor{hfReflectBg}{HTML}{F4EEF9}
\definecolor{hfWord}{HTML}{6B7280}
\definecolor{hfWordBg}{HTML}{F4F4F5}

\definecolor{hfSource}{HTML}{4A4A4A}  % the plant, a device, a data source
\definecolor{hfReader}{HTML}{1F5FA8}  % programs that read: clients, screens
\definecolor{hfStore}{HTML}{2E7D4F}   % storage: history, copies, archives
\definecolor{hfBus}{HTML}{7B3FA0}     % something in the middle: broker, standard
\definecolor{hfAlert}{HTML}{C0392B}   % a cost, a pain, something forbidden

% ---------------------------------------------------------------------------
% Boxes
% ---------------------------------------------------------------------------
\tcbset{
  hf/box/.style={
    enhanced, breakable,
    boxrule=0pt, leftrule=3pt, arc=0pt, outer arc=0pt,
    left=10pt, right=10pt, top=7pt, bottom=7pt,
    before skip=12pt, after skip=12pt,
    parbox=false,
  },
}
% paragraphs inside boxes: no indent, a small gap
\newcommand\hf@paras{\setlength{\parindent}{0pt}\setlength{\parskip}{0.45em}}

% A box may only split across pages when at least 40% of it stays on the
% first page. Each box is measured first; if less than 40% of its height is
% left on the page, it starts on the next one.
% The test is done by hand rather than with \needspace: needspace leaves a
% \penalty-100 behind, and with \raggedbottom TeX then prefers to break the
% page right there even when the whole box would fit.
\raggedbottom
\newsavebox\hf@measure
\newlength\hf@need
\newlength\hf@left
\newcommand\hf@needspace[1]{\par
  \setlength\hf@left{\pagegoal}\addtolength\hf@left{-\pagetotal}%
  \ifdim #1>\hf@left \ifdim\hf@left>\z@ \newpage\fi\fi}
% #1 = box environment, #2 = title, #3 = body
\newcommand\hf@keeptogether[3]{%
  \sbox\hf@measure{\parbox{\linewidth}{%
    \begin{#1}[unbreakable]{#2}#3\end{#1}}}%
  \setlength\hf@need{\ht\hf@measure}%
  \addtolength\hf@need{\dp\hf@measure}%
  \setlength\hf@need{0.4\hf@need}%
  \hf@needspace{\hf@need}%
  \begin{#1}{#2}#3\end{#1}}

% \begin{history}{1900 · Berlin} ... \end{history}
\NewDocumentEnvironment{history}{m +b}
  {\hf@keeptogether{hf@history}{#1}{#2}}{}
\newtcolorbox{hf@history}[2][]{
  hf/box, colback=hfHistoryBg, colframe=hfHistory,
  before upper={\hf@paras{\sffamily\bfseries\footnotesize\color{hfHistory}%
    HISTORY\enspace\textperiodcentered\enspace #2}\par\smallskip},
  #1,
}

% \begin{concept}{Interference} ... \end{concept}
\NewDocumentEnvironment{concept}{m +b}
  {\hf@keeptogether{hf@concept}{#1}{#2}}{}
\newtcolorbox{hf@concept}[2][]{
  hf/box, colback=hfConceptBg, colframe=hfConcept,
  before upper={\hf@paras{\sffamily\bfseries\footnotesize\color{hfConcept}%
    KEY CONCEPT\enspace\textperiodcentered\enspace #2}\par\smallskip},
  #1,
}

% \begin{question}{If a qubit holds both answers, why can't I read both?} ... \end{question}
%   the question a reader is embarrassed to ask, and its answer
\NewDocumentEnvironment{question}{m +b}
  {\hf@keeptogether{hf@question}{#1}{#2}}{}
\newtcolorbox{hf@question}[2][]{
  hf/box, colback=hfQuestionBg, colframe=hfQuestion,
  before upper={\hf@paras{\sffamily\bfseries\footnotesize\color{hfQuestion}%
    DUMB QUESTION}\par\smallskip
    {\large\bfseries\color{hfQuestion}#2}\par\medskip},
  #1,
}

% \begin{reflection}{The energy of a whole circuit comes in steps?} ... \end{reflection}
%   a pause on something that should bother you, and why it is true
\NewDocumentEnvironment{reflection}{m +b}
  {\hf@keeptogether{hf@reflection}{#1}{#2}}{}
\newtcolorbox{hf@reflection}[2][]{
  hf/box, colback=hfReflectBg, colframe=hfReflect,
  before upper={\hf@paras{\sffamily\bfseries\footnotesize\color{hfReflect}%
    REFLECTION}\par\smallskip
    {\large\bfseries\color{hfReflect}#2}\par\medskip},
  #1,
}

% \begin{etymology} ... \end{etymology}   where the words come from
\newtcolorbox{etymology}{
  hf/box, colback=hfWordBg, colframe=hfWord, fontupper=\small,
  before upper={\hf@paras{\sffamily\bfseries\footnotesize\color{hfWord}%
    WHERE THE WORDS COME FROM}\par\smallskip},
}

% ---------------------------------------------------------------------------
% Code
%   \begin{code} ... \end{code}          source code, light gray
%   \begin{terminal} ... \end{terminal}  what a command printed, dark
% ---------------------------------------------------------------------------
\RequirePackage{listings}
\tcbuselibrary{listings}
\lstdefinelanguage{hfts}{
  morekeywords={import,from,export,default,const,let,function,async,await,
    return,if,for,of,as,new,throw,type,true,false},
  sensitive=true,
  morecomment=[l]{//},
  morestring=[b]', morestring=[b]",
}
\lstdefinestyle{hf}{
  basicstyle=\ttfamily\footnotesize, columns=fullflexible, keepspaces=true,
  showstringspaces=false, upquote=true, breaklines=true,
  keywordstyle=\color{hfConcept}\bfseries,
  commentstyle=\color{black!50}\itshape,
  stringstyle=\color{hfStore},
  escapeinside={(*}{*)},
}
\newtcblisting{code}[1][]{
  hf/box, colback=black!3, colframe=black!30, leftrule=2pt,
  top=4pt, bottom=4pt, before skip=8pt, after skip=8pt,
  listing only, listing options={style=hf,language=Python,#1},
}
\newtcblisting{terminal}[1][]{
  hf/box, colback=black!82, colframe=black!82, leftrule=2pt, coltext=white,
  top=4pt, bottom=4pt, before skip=8pt, after skip=8pt,
  listing only, listing options={style=hf,#1},
}

% ---------------------------------------------------------------------------
% Diagram styles
% ---------------------------------------------------------------------------
\tikzset{
  hf/base/.style={draw, rounded corners=2pt, font=\sffamily\small, align=center,
    minimum height=8mm, inner sep=4pt, line width=0.8pt},
  hf/source/.style={hf/base, draw=hfSource, fill=hfSource!10},
  hf/reader/.style={hf/base, draw=hfReader, fill=hfReader!10},
  hf/bus/.style={hf/base, draw=hfBus, fill=hfBus!10},
  hf/store/.style={draw=hfStore, fill=hfStore!10, line width=0.8pt,
    cylinder, shape border rotate=90, aspect=0.22, minimum height=9mm,
    minimum width=18mm, font=\sffamily\small, align=center, inner sep=3pt},
  hf/flow/.style={-{Stealth[length=2.2mm]}, line width=0.8pt},
  hf/ask/.style={hf/flow, draw=hfReader},
  hf/answer/.style={hf/flow, draw=hfSource, dashed},
  hf/push/.style={hf/flow, draw=hfBus},
  hf/save/.style={hf/flow, draw=hfStore},
  hf/pain/.style={line width=0.8pt, draw=hfAlert},
  hf/note/.style={font=\sffamily\footnotesize, text=black!65, align=center},
  hf/lifeline/.style={draw=black!25, line width=0.6pt},
}

